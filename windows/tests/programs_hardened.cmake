# The programs are built with Control Flow Guard and marked CET shadow-stack compatible, as their own PE headers
# say (dumpbin, from the build tools that are on PATH as ctest runs). -DPROGRAMS=<exe>|<exe> ("|" between them)
find_program(DUMPBIN dumpbin)
if(NOT DUMPBIN)
    message(FATAL_ERROR "dumpbin isn't on PATH: run ctest with the build tools' environment")
endif()
string(REPLACE "|" ";" programs "${PROGRAMS}")
foreach(exe IN LISTS programs)
    get_filename_component(name "${exe}" NAME)
    execute_process(COMMAND "${DUMPBIN}" /nologo /headers "${exe}" OUTPUT_VARIABLE out RESULT_VARIABLE rc)
    if(NOT rc EQUAL 0)
        message(FATAL_ERROR "dumpbin /headers failed on ${name} (${rc})")
    endif()
    if(NOT out MATCHES "Control Flow Guard")
        message(FATAL_ERROR "${name} isn't built with Control Flow Guard (/guard:cf)")
    endif()
    if(NOT out MATCHES "CET compatible")
        message(FATAL_ERROR "${name} isn't marked CET shadow-stack compatible (/CETCOMPAT)")
    endif()
    message(STATUS "${name}: Control Flow Guard, CET compatible")
endforeach()
