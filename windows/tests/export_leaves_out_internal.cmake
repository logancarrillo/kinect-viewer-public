# The open-source export is `git archive` of a commit, and .gitattributes marks docs/internal/ export-ignore: the
# private repository's process notes never reach it, while the rest of the tree does. Nor do the notes' own words:
# docs/internal/export-forbidden-words.txt lists them (it is left out of the export itself, so publishing this row
# never publishes the words), and no exported file's name or text may hold one. Run from a git checkout only.
# -DGIT=<git> -DREPO=<the repository's root> -DOUTDIR=<a folder for the archive>
execute_process(COMMAND "${GIT}" -C "${REPO}" ls-tree -r --name-only HEAD -- docs/internal
    OUTPUT_VARIABLE internal RESULT_VARIABLE rc)
if(NOT rc EQUAL 0)
    message(FATAL_ERROR "git ls-tree failed (${rc})")
endif()
if(internal STREQUAL "")
    message(FATAL_ERROR "HEAD has no docs/internal/, so this proves nothing: keep the process notes there")
endif()

# The words, read from the commit being exported. A missing or empty list fails: it would check nothing.
execute_process(COMMAND "${GIT}" -C "${REPO}" show HEAD:docs/internal/export-forbidden-words.txt
    OUTPUT_VARIABLE words_text ERROR_VARIABLE words_error RESULT_VARIABLE rc)
if(NOT rc EQUAL 0)
    message(FATAL_ERROR "HEAD has no docs/internal/export-forbidden-words.txt, so the export can't be checked for the "
        "private notes' words")
endif()
if(words_text MATCHES ";")
    message(FATAL_ERROR "export-forbidden-words.txt: no ';' in an entry")
endif()
string(REPLACE "\r" "" words_text "${words_text}")
string(REPLACE "\n" ";" word_lines "${words_text}")
set(words "")
foreach(line IN LISTS word_lines)
    string(STRIP "${line}" line)
    if(line STREQUAL "" OR line MATCHES "^#")
        continue()
    endif()
    if(NOT line MATCHES "^[A-Za-z0-9_./ -]+$")
        message(FATAL_ERROR "export-forbidden-words.txt: letters, digits, spaces and _ . / - only, not '${line}'")
    endif()
    string(TOLOWER "${line}" line)
    list(APPEND words "${line}")
endforeach()
if(NOT words)
    message(FATAL_ERROR "export-forbidden-words.txt lists no words, so this proves nothing")
endif()

set(tar "${OUTDIR}/export_leaves_out_internal.tar")
set(scan "${OUTDIR}/export_leaves_out_internal")
file(REMOVE "${tar}")
file(REMOVE_RECURSE "${scan}")
execute_process(COMMAND "${GIT}" -C "${REPO}" archive --format=tar -o "${tar}" HEAD RESULT_VARIABLE rc)
if(NOT rc EQUAL 0)
    message(FATAL_ERROR "git archive failed (${rc})")
endif()
execute_process(COMMAND "${CMAKE_COMMAND}" -E tar tf "${tar}" OUTPUT_VARIABLE listing RESULT_VARIABLE rc)
if(NOT rc EQUAL 0)
    file(REMOVE "${tar}")
    message(FATAL_ERROR "listing the archive failed (${rc})")
endif()
file(MAKE_DIRECTORY "${scan}")
execute_process(COMMAND "${CMAKE_COMMAND}" -E tar xf "${tar}" WORKING_DIRECTORY "${scan}" RESULT_VARIABLE rc)
file(REMOVE "${tar}")
if(NOT rc EQUAL 0)
    file(REMOVE_RECURSE "${scan}")
    message(FATAL_ERROR "unpacking the archive failed (${rc})")
endif()
string(REPLACE "\r" "" listing "${listing}")
if(listing MATCHES "(^|\n)docs/internal")
    file(REMOVE_RECURSE "${scan}")
    message(FATAL_ERROR "the export includes docs/internal/:\n${listing}")
endif()
foreach(kept docs/pet-camera.md docs/protocol-v3-pet-camera.md README.md windows/CMakeLists.txt)
    if(NOT listing MATCHES "(^|\n)${kept}(\n|$)")
        file(REMOVE_RECURSE "${scan}")
        message(FATAL_ERROR "the export lacks ${kept}: not a real export")
    endif()
endforeach()

# Every exported file, by name and by text, matched whole and ignoring case. string(FIND) finds a candidate fast;
# the regular expression then asks that no letter, digit or _ touches it on either side.
file(GLOB_RECURSE exported LIST_DIRECTORIES false RELATIVE "${scan}" "${scan}/*")
list(LENGTH exported exported_count)
if(exported_count LESS 50)
    file(REMOVE_RECURSE "${scan}")
    message(FATAL_ERROR "only ${exported_count} files unpacked: not a real export")
endif()
set(found "")
foreach(rel IN LISTS exported)
    file(READ "${scan}/${rel}" content)
    string(TOLOWER "${rel}\n${content}" content)
    foreach(word IN LISTS words)
        string(FIND "${content}" "${word}" at)
        if(at GREATER -1)
            string(REPLACE "." "\\." word_rx "${word}")
            if(content MATCHES "(^|[^a-z0-9_])${word_rx}([^a-z0-9_]|$)")
                list(APPEND found "${rel}: ${word}")
            endif()
        endif()
    endforeach()
endforeach()
file(REMOVE_RECURSE "${scan}")
if(found)
    list(JOIN found "\n  " found)
    message(FATAL_ERROR "the export holds words from the private notes:\n  ${found}")
endif()
list(LENGTH words word_count)
message(STATUS "the export leaves out docs/internal/, keeps the rest, and none of its ${exported_count} files holds "
    "any of the ${word_count} listed words")
